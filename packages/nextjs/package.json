{
  "name": "@se-2/nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:static": "bash scripts/build-static.sh",
    "check-types": "next typegen && tsc --noEmit --incremental",
    "test": "node --experimental-strip-types --test \"utils/**/*.test.ts\"",
    "relayer:crash-check": "node scripts/relayer-crash-check.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "format": "prettier --write . '!(node_modules|.next|contracts)/**/*'",
    "lint": "eslint .",
    "serve": "next start",
    "start": "next dev --hostname 0.0.0.0"
  },
  "dependencies": {
    "@heroicons/react": "~2.1.5",
    "@rainbow-me/rainbowkit": "2.2.5",
    "@tanstack/react-query": "~5.59.15",
    "blo": "~1.2.0",
    "burner-connector": "0.0.14",
    "daisyui": "5.0.9",
    "next": "15.5.27",
    "next-nprogress-bar": "~2.3.13",
    "next-themes": "~0.3.0",
    "qrcode.react": "~4.0.1",
    "react": "~19.0.8",
    "react-dom": "~19.0.8",
    "react-hot-toast": "~2.4.0",
    "react-qr-code": "^2.0.6",
    "usehooks-ts": "~3.1.0",
    "viem": "2.30.0",
    "wagmi": "2.15.4",
    "zustand": "~5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.0.15",
    "@trivago/prettier-plugin-sort-imports": "~4.3.0",
    "@types/node": "~18.19.50",
    "@types/react": "~19.0.7",
    "@types/react-dom": "^19",
    "abitype": "1.0.6",
    "autoprefixer": "~10.4.20",
    "eslint": "~9.23.0",
    "eslint-config-next": "15.5.27",
    "eslint-config-prettier": "~10.1.1",
    "eslint-plugin-prettier": "~5.2.4",
    "postcss": "8.5.23",
    "prettier": "~3.5.3",
    "tailwindcss": "4.1.3",
    "type-fest": "~4.26.1",
    "typescript": "~5.8.2"
  },
  "packageManager": "yarn@3.2.3"
}
